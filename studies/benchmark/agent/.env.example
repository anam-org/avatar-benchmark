# Copy to agent/.env and fill in. NEVER commit agent/.env (gitignored).
# The agent falls back to the repo-root .env, so a single file there works too.

# LiveKit Cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Project the agent deploys to, and the agent it updates. deploy.sh builds
# livekit.toml from LIVEKIT_AGENT_ID and the host label of LIVEKIT_URL.
LIVEKIT_AGENT_PROJECT=
LIVEKIT_AGENT_ID=

# The shared pipeline every condition runs.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=

# Face layers, one key per provider. The HeyGen plugin takes a LiveAvatar
# key, NOT the HEYGEN_API_KEY the worker uses for the turnkey study.
ANAM_API_KEY=
TAVUS_API_KEY=
LEMONSLICE_API_KEY=
LIVEAVATAR_API_KEY=
SYNTHESIA_API_KEY=
