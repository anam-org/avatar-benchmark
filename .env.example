# Copy to .env and fill in. NEVER commit .env (gitignored).
# Values are read literally to end-of-line: keep comments on their own lines.

# Provider accounts the study mints sessions against
ANAM_API_KEY=
TAVUS_API_KEY=
# HeyGen LiveAvatar (api.liveavatar.com) key
HEYGEN_API_KEY=
# LiveAvatar contexts holding the task prompt, one per round
LIVEAVATAR_CONTEXT_ID_MAIN=
LIVEAVATAR_CONTEXT_ID_PRACTICE=
LEMONSLICE_API_KEY=
# LiveAvatar key the LiveKit agent's face plugin uses
LIVEAVATAR_API_KEY=
SYNTHESIA_API_KEY=

# Rating platform
MABYDUCK_API_KEY=
MABYDUCK_PROJECT_ID=
# Rater pool jobs recruit from
MABYDUCK_RATER_POOL_ID=
# Temporary random hex key for public evidence IDs (32 bytes minimum).
# Reuse for related study exports, then discard. Never publish its value.
BENCHMARK_EXPORT_KEY=

# Harness worker
# Deployed worker origin, e.g. https://<name>.workers.dev
BENCHMARK_BASE_URL=
# HMAC key signing stimulus URLs. Must equal the worker secret of the same
# name (wrangler secret bulk), or every mint returns 403.
BENCHMARK_URL_SECRET=
# Days a built dataset's stimulus URLs keep minting. Optional, default 30.
BENCHMARK_URL_TTL_DAYS=
# Stamped into every mint manifest as workerCommit. Optional; the deploy
# workflow sets it from the commit it builds.
PUBLIC_WORKER_COMMIT=
# Cloudflare account owning the KV namespace, for the KV REST API. The
# namespace id itself is read from wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=
# Workers KV Storage:Read on that account. Optional: a `wrangler login`
# serves instead, and is what a local bundle build normally uses.
CLOUDFLARE_API_TOKEN=

# LiveKit study only. Needed in THREE places: as worker secrets (/api/livekit
# mints the room token server-side), by the agent (agent/.env), and here for
# the scripts. A single .env at the repo root serves the last two.
# LiveKit Cloud project the agent deploys to
LIVEKIT_AGENT_PROJECT=
# The deployed agent this updates; livekit.toml is generated from it
LIVEKIT_AGENT_ID=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The shared pipeline every LiveKit condition runs
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
# Seconds the agent waits after the Synthesia avatar publishes before the
# opening turn. Optional, default 3.
SYNTHESIA_SETTLE_SECONDS=
